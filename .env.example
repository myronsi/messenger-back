# Copy to .env and fill in a generated value. Never commit .env.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Behind nginx with the API under /api over HTTPS (production):
# COOKIE_PATH_PREFIX=/api
# COOKIE_SECURE=true
# Only needed when the frontend is served from a different origin than the API (comma separated).
# Defaults to the local Vite dev/preview origins. "*" is not accepted.
# CORS_ORIGINS=https://app.example.com
# Host names the API answers to (comma separated). Unset = no check. Your proxy must pass the Host header.
# ALLOWED_HOSTS=chat.example.com,127.0.0.1

# Local testing from other devices on your network (never on the public server):
# BACKEND_BIND=0.0.0.0
