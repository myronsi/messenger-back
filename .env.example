# Copy to .env and fill in a generated value. Never commit .env.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Behind nginx with the API under /api over HTTPS (production):
# COOKIE_PATH_PREFIX=/api
# COOKIE_SECURE=true
# Only needed when the frontend is served from a different origin than the API (comma separated).
# Defaults to the local Vite dev/preview origins. "*" is not accepted.
# CORS_ORIGINS=https://app.example.com
# Host names the API answers to (comma separated). Unset = no check. Your proxy must pass the Host header.
# ALLOWED_HOSTS=chat.example.com,127.0.0.1
# WebSockets authenticate with one-time tickets (POST /auth/ws-ticket). While old browser tabs may still
# be open, the access token in the URL is accepted too; set to false once everyone has reloaded.
# WS_ALLOW_QUERY_TOKEN=true
# Oldest client API contract version (X-Client-Api-Version) still served; older clients get 426 client_outdated.
# Raise it only deliberately and mention it in the release notes.
# MIN_CLIENT_API_VERSION=1.0.0
# Serve request counts per client API version at GET /metrics (Prometheus format). Do not expose it through the public proxy.
# METRICS_ENABLED=false

# Local testing from other devices on your network (never on the public server):
# BACKEND_BIND=0.0.0.0

# ---------------------------------------------------------------------------------------------
# Go backend (cmd/api, cmd/worker). The process refuses to start when a required value is missing
# or too weak. `make run` reads this file; keep it as plain KEY=value lines (no quotes, no spaces).
# ---------------------------------------------------------------------------------------------

# Required secrets. Never commit real values.
# JWT_SECRET and RECOVERY_PEPPER: at least 32 characters.  openssl rand -base64 48
# ENCRYPTION_KEY: exactly 32 random bytes, base64 encoded.  openssl rand -base64 32
JWT_SECRET=
ENCRYPTION_KEY=
RECOVERY_PEPPER=

# Required data stores. Local defaults for the development environment (MSGC-67).
DATABASE_URL=postgres://messenger:messenger@localhost:5432/messenger?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# Comma separated; the keyspace may stay empty until the ScyllaDB migrations have run.
SCYLLA_HOSTS=localhost
SCYLLA_KEYSPACE=
ELASTICSEARCH_URL=http://localhost:9200

# development | test | production (production adds HSTS and requires https CORS origins).
# APP_ENV=development
# debug | info | warn | error
# LOG_LEVEL=info

# HTTP server.
# HTTP_ADDR=:8080
# Where the REST contract is served; must match `servers` in api/openapi.yaml.
# API_BASE_PATH=/api/v2
# Allowed browser origins, comma separated. Empty = same-origin only; "*" is not accepted.
# CORS_ORIGINS=http://localhost:5173
# HTTP_MAX_BODY_BYTES=1048576
# HTTP_REQUEST_TIMEOUT=30s
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=60s
# HTTP_IDLE_TIMEOUT=120s
# Graceful shutdown: how long /readyz answers 503 before the listener closes (give the load
# balancer time to notice, for example 5s), and how long in-flight requests may take.
# HTTP_DRAIN_DELAY=0s
# HTTP_SHUTDOWN_TIMEOUT=25s
# READINESS_TIMEOUT=2s

# Worker: address of its /healthz and /metrics.
# WORKER_ADDR=:8081

# Optional OpenTelemetry tracing (OTLP over HTTP). Configure the exporter with the standard
# OTEL_EXPORTER_OTLP_* variables.
# OTEL_TRACING_ENABLED=false
# OTEL_SERVICE_NAME=messenger
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
