# Copy to .env and fill in a generated value. Never commit .env.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Behind nginx with the API under /api over HTTPS (production):
# COOKIE_PATH_PREFIX=/api
# COOKIE_SECURE=true
# Only needed when the frontend is served from a different origin than the API (comma separated).
# Defaults to the local Vite dev/preview origins. "*" is not accepted.
# CORS_ORIGINS=https://app.example.com
# Host names the API answers to (comma separated). Unset = no check. Your proxy must pass the Host header.
# ALLOWED_HOSTS=chat.example.com,127.0.0.1
# WebSockets authenticate with one-time tickets (POST /auth/ws-ticket). While old browser tabs may still
# be open, the access token in the URL is accepted too; set to false once everyone has reloaded.
# WS_ALLOW_QUERY_TOKEN=true
# Oldest client API contract version (X-Client-Api-Version) still served; older clients get 426 client_outdated.
# Raise it only deliberately and mention it in the release notes.
# MIN_CLIENT_API_VERSION=1.0.0
# Serve request counts per client API version at GET /metrics (Prometheus format). Do not expose it through the public proxy.
# METRICS_ENABLED=false

# Local testing from other devices on your network (never on the public server):
# BACKEND_BIND=0.0.0.0

# ---------------------------------------------------------------------------------------------
# Go backend (cmd/api, cmd/worker). The process refuses to start when a required value is missing
# or too weak. `make run` reads this file; keep it as plain KEY=value lines (no quotes, no spaces).
# ---------------------------------------------------------------------------------------------

# Required secrets. Never commit real values.
# JWT_SECRET and RECOVERY_PEPPER: at least 32 characters.  openssl rand -base64 48
# ENCRYPTION_KEY: exactly 32 random bytes, base64 encoded.  openssl rand -base64 32
JWT_SECRET=
ENCRYPTION_KEY=
RECOVERY_PEPPER=

# Required data stores, as seen from the host (`make run`). The values match the development stack
# (compose.dev.yaml, published on 127.0.0.1); inside compose the containers get their own URLs.
# ${NAME} references are expanded by `make env`. The ports follow the *_PORT values below.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/0
# Comma separated. The keyspace is created by the dev stack.
SCYLLA_HOSTS=localhost:${SCYLLA_PORT}
SCYLLA_KEYSPACE=messenger
ELASTICSEARCH_URL=http://elastic:${ELASTIC_PASSWORD}@localhost:${ELASTICSEARCH_PORT}

# development | test | production (production adds HSTS and requires https CORS origins).
# APP_ENV=development
# debug | info | warn | error
# LOG_LEVEL=info

# PostgreSQL pool (the connection URL is DATABASE_URL).
# POSTGRES_MAX_CONNS=10
# POSTGRES_QUERY_TIMEOUT=5s

# HTTP server.
# HTTP_ADDR=:8080
# Where the REST contract is served; must match `servers` in api/openapi.yaml.
# API_BASE_PATH=/api/v2
# Allowed browser origins, comma separated. Empty = same-origin only; "*" is not accepted.
# CORS_ORIGINS=http://localhost:5173
# HTTP_MAX_BODY_BYTES=1048576
# HTTP_REQUEST_TIMEOUT=30s
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=30s
# HTTP_WRITE_TIMEOUT=60s
# HTTP_IDLE_TIMEOUT=120s
# Graceful shutdown: how long /readyz answers 503 before the listener closes (give the load
# balancer time to notice, for example 5s), and how long in-flight requests may take.
# HTTP_DRAIN_DELAY=0s
# HTTP_SHUTDOWN_TIMEOUT=25s
# READINESS_TIMEOUT=2s

# Worker: address of its /healthz and /metrics.
# WORKER_ADDR=:8081

# Authentication. The refresh cookie is Secure unless this is false; plain-HTTP local runs need false,
# production refuses to start with false.
COOKIE_SECURE=false
# The cookie path defaults to <API_BASE_PATH>/auth/refresh. While v1 sessions are migrated (MSGC-77) set
# the old path so the browser sends the existing cookie: REFRESH_COOKIE_PATH=/auth
# REFRESH_COOKIE_PATH=
# Reverse proxies (IPs or CIDRs, comma-separated) whose X-Forwarded-For / X-Real-IP headers are believed
# when working out the client address for rate limits and session records. Empty trusts no proxy, so the
# TCP peer address is used. Set it to your load balancer or ingress range when the API runs behind one.
# TRUSTED_PROXIES=
# How long Redis caches an active session (revocations apply at once) and how long the previous refresh
# token is tolerated after a rotation (two tabs refreshing together). 0 turns the tolerance off.
# SESSION_CACHE_TTL=30s
# REFRESH_REUSE_GRACE=10s
# Simultaneous Argon2 hashes (64 MiB each).
# PASSWORD_HASH_CONCURRENCY=4

# Optional OpenTelemetry tracing (OTLP over HTTP). Configure the exporter with the standard
# OTEL_EXPORTER_OTLP_* variables.
# OTEL_TRACING_ENABLED=false
# OTEL_SERVICE_NAME=messenger
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---------------------------------------------------------------------------------------------
# Development stack (compose.dev.yaml): `make env` creates .env with all of these generated.
# Development only. Use URL-safe values: they are placed inside connection URLs.
# ---------------------------------------------------------------------------------------------

# docker compose reads this file. `make env` enables the line below in the .env it generates, so a plain
# `docker compose up` starts this stack. Leave it unset where the root compose.yaml (Python backend) is meant.
# COMPOSE_FILE=compose.dev.yaml

POSTGRES_USER=messenger
POSTGRES_DB=messenger
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Password of the built-in `elastic` user; KIBANA_PASSWORD is for `kibana_system` (Kibana profile).
ELASTIC_PASSWORD=
KIBANA_PASSWORD=
# S3-compatible object storage (access key >= 3 characters, secret >= 8). Buckets are created at startup.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKETS=messenger-media

# Host ports of the stores (bound to 127.0.0.1). The URLs above are expanded by `make env`,
# so change a port before generating .env, or edit the matching URL by hand afterwards.
POSTGRES_PORT=5432
REDIS_PORT=6379
SCYLLA_PORT=9042
ELASTICSEARCH_PORT=9200

# Other optional host port overrides.
# API_PORT=8080
# WORKER_PORT=8081
# S3_PORT=9000
# S3_CONSOLE_PORT=9001
# KIBANA_PORT=5601
