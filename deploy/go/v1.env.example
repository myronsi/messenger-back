# The Python backend's credentials for the data copy (migrate-v1.sh, docs/switchover.md), kept as v1.env
# (mode 0600) next to .env. Only the migrate-v1 container reads it, never api or worker. Delete it after the
# switch.

# A read-only user on the Python backend's database; the host is its container on the Python stack's
# network (V1_NETWORK in .env).
V1_DATABASE_URL=postgres://readonly:password@messenger-postgres-1:5432/messenger
# The Python backend's SECRET_KEY, which encrypted the TOTP secrets.
V1_SECRET_KEY=
