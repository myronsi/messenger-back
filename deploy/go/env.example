# Environment of the Go backend's stack (deploy/go/compose.yaml), kept as .env next to it on the server.
# Plain KEY=value lines: no quotes and no spaces. The containers read the file as it is, so the ${NAME}
# references below must be replaced: genenv does that. Never commit real values; production takes them from
# the secret manager (docs/deploy-go.md).
#
# For staging with single-node stores on the host, generate one with fresh secrets:
#   go run deploy/dev/genenv.go deploy/go/env.example /opt/messenger-go/.env
# and fill in what is left empty below.

# Set by deploy.sh: the released image (ghcr.io/myronsi/messenger-back:vX.Y.Z).
BACKEND_IMAGE=

# stores: single-node PostgreSQL, Redis, ScyllaDB, Elasticsearch and object storage on this host, for
# staging. Production leaves it empty and points the URLs below at its own clusters (docs/deployment.md).
COMPOSE_PROFILES=stores

APP_ENV=production
LOG_LEVEL=info

# Required secrets. JWT_SECRET and RECOVERY_PEPPER: at least 32 characters (openssl rand -base64 48);
# ENCRYPTION_KEY: exactly 32 random bytes, base64 encoded (openssl rand -base64 32).
JWT_SECRET=
ENCRYPTION_KEY=
RECOVERY_PEPPER=

# Optional passkeys. Use the frontend hostname and its exact HTTPS origin(s), not the API origin.
RP_ID=
RP_ORIGINS=

# Optional recovery email. API and worker share these settings. Empty SMTP_HOST disables delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
RECOVERY_WEB_URL=

# Approximate location of sessions, security events and recovery requests (docs/geoip.md). deploy.sh downloads
# the DB-IP Lite city database into the geoip-data volume when it is missing; empty turns locations off.
GEOIP_DB_PATH=/geoip/dbip-city-lite.mmdb

# Passwords of the bundled stores (COMPOSE_PROFILES=stores only; the stores keep the ones they were first
# started with).
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ELASTIC_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# The stores. These match the bundled ones; with your own clusters use their URLs (TLS: sslmode=verify-full,
# rediss://, https://).
DATABASE_URL=postgres://messenger:${POSTGRES_PASSWORD}@postgres:5432/messenger?sslmode=disable
# The URL deploy.sh backs up (pg_dump, libpq) when DATABASE_URL does not suit it: libpq looks for its CA in
# ~/.postgresql/root.crt, so with sslmode=verify-full add sslrootcert=system (the system's CAs).
# BACKUP_DATABASE_URL=
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
SCYLLA_HOSTS=scylla
SCYLLA_KEYSPACE=messenger
# golang-migrate's URL of the same keyspace (with username, password and tls parameters for a cluster).
SCYLLA_MIGRATE_URL=cassandra://scylla:9042/messenger?x-multi-statement=true
# LOCAL_QUORUM needs replication factor 3; the single bundled node has 1.
SCYLLA_CONSISTENCY=one
ELASTICSEARCH_URL=http://elastic:${ELASTIC_PASSWORD}@elasticsearch:9200
# 0 on a single node; at least 1 on a cluster.
SEARCH_REPLICAS=0
STORAGE_BACKEND=s3
S3_ENDPOINT=http://object-storage:9000
S3_BUCKET=messenger-media

# Behind the reverse proxy, over HTTPS.
COOKIE_SECURE=true
CORS_ORIGINS=https://chat.example.com
# The proxy's address, so client addresses come from X-Forwarded-For. Unset, only loopback
# (127.0.0.0/8, ::1) is trusted. A proxy on the host reaches the api container through Docker's
# bridge gateway, so set the Docker network range here, or every client shares one rate limit.
# TRUSTED_PROXIES=172.16.0.0/12
# Refresh cookies must match the public Go refresh endpoint.
REFRESH_COOKIE_PATH=/api/v2/auth/refresh
HTTP_DRAIN_DELAY=5s

# Where the API listens on the host for the reverse proxy, and the worker's health and metrics port
# (keep both off the internet).
API_BIND=127.0.0.1
API_PORT=8080
WORKER_PORT=8081

# Audio calls (docs/calls.md). Off by default: messaging is unaffected and deploy.sh stops the media server.
# With true, deploy.sh refuses to deploy until every setting below that has no default is set, and starts the
# livekit service (COMPOSE profile calls). Turning it off again ends running calls.
CALLS_ENABLED=false
# The signalling URL browsers use (the calls.<domain> server block in nginx, deploy/go/livekit/).
CALLS_PUBLIC_URL=wss://calls.example.com
# How the API reaches LiveKit's room API inside the compose network.
CALLS_API_URL=http://livekit:7880
# The key names the secret; the secret signs media grants and webhooks: at least 32 characters, letters,
# digits and + / = _ - only (openssl rand -hex 32). genenv generates both. Rotation: docs/deploy-go.md.
CALLS_API_KEY=
CALLS_API_SECRET=
# Joined sessions per call (also LiveKit's room limit) and across all calls on this host.
CALLS_MAX_PARTICIPANTS=10
# Raise it only after the load test (docs/calls.md#load-test); the target is 250.
CALLS_MAX_ACTIVE_PARTICIPANTS=50
CALLS_RING_TIMEOUT=30s
CALLS_EMPTY_GRACE=20s
CALLS_TOKEN_TTL=10m

# The media server (livekit service). CALLS_NODE_IP is the host's Elastic IP, which LiveKit tells browsers.
CALLS_NODE_IP=
# TURN over TLS for networks that block UDP: its own DNS name (A record to the Elastic IP) and certificate,
# readable by the deploy user (copied there by the certbot deploy hook in docs/deploy-go.md).
CALLS_TURN_DOMAIN=turn.example.com
CALLS_TURN_CERT_FILE=/opt/messenger-go/tls/turn/fullchain.pem
CALLS_TURN_KEY_FILE=/opt/messenger-go/tls/turn/privkey.pem
# Where TURN/TLS listens. Default: port 5349 on every address, with its own Security Group rule. Behind
# nginx's stream block on 443 (deploy/go/livekit/nginx-turn-443-stream.conf.example):
# CALLS_TURN_TLS_PORT=443 and CALLS_TURN_TLS_PUBLISH=127.0.0.1:5349.
CALLS_TURN_TLS_PORT=5349
CALLS_TURN_TLS_PUBLISH=0.0.0.0:5349
# Public ports (Security Group): ICE over UDP (multiplexed, one port per vCPU or more), ICE over TCP,
# TURN/UDP and TURN relay ports (each TURN user holds about two, so 97 ports carry about 48 TURN users at
# once; docs/calls.md#limits). One Security Group rule covers
# 50000-50100/udp. Each port is the same on the host and in the container.
CALLS_UDP_PORT_START=50000
CALLS_UDP_PORT_END=50003
CALLS_TCP_PORT=7881
CALLS_TURN_UDP_PORT=3478
CALLS_TURN_RELAY_PORT_START=50004
CALLS_TURN_RELAY_PORT_END=50100
# Loopback only: signalling for nginx (calls.<domain>) and Prometheus metrics.
CALLS_HTTP_PORT=7880
CALLS_METRICS_PORT=6789
# Caps of the media server, so it cannot starve messaging and the stores (docs/deployment.md).
CALLS_CPUS=1.0
CALLS_MEM_LIMIT=1g

# Optional message push. API and worker need the same values; see docs/notifications.md.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:operator@example.com
# PUSH_FCM_SERVICE_ACCOUNT=
# PUSH_APNS_KEY=
# PUSH_APNS_KEY_ID=
# PUSH_APNS_TEAM_ID=
# PUSH_APNS_TOPIC=com.messenger.app
# PUSH_APNS_SANDBOX=false
