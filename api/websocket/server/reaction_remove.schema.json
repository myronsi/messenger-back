{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerReactionRemoveEvent",
  "description": "A reaction was removed.",
  "type": "object",
  "properties": {
    "type": {
      "const": "reaction_remove"
    },
    "event_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "chat_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "data": {
      "type": "object",
      "properties": {
        "message_id": {
          "$ref": "../../openapi.yaml#/components/schemas/Id"
        },
        "reaction": {
          "$ref": "../../openapi.yaml#/components/schemas/Reaction"
        }
      },
      "required": [
        "message_id",
        "reaction"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "event_id",
    "chat_id",
    "data"
  ],
  "additionalProperties": false
}
