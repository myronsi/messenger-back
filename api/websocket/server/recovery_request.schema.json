{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerRecoveryRequestEvent",
  "type": "object",
  "required": [
    "type",
    "event_id",
    "chat_id",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "recovery_request"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "chat_id": {
      "type": "null"
    },
    "data": {
      "type": "object",
      "required": [
        "request_id",
        "user_agent",
        "ip_hint",
        "choices",
        "expires_at"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "user_agent": {
          "type": "string"
        },
        "ip_hint": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 10,
            "maximum": 99
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
