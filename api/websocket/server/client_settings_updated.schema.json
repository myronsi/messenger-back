{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerClientSettingsUpdatedEvent",
  "description": "The synced settings changed on one of your devices (sent only to your own sessions).",
  "type": "object",
  "required": [
    "type",
    "event_id",
    "chat_id",
    "data"
  ],
  "properties": {
    "type": {
      "const": "client_settings_updated"
    },
    "event_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "chat_id": {
      "type": "null"
    },
    "data": {
      "$ref": "../../openapi.yaml#/components/schemas/ClientSettings"
    }
  }
}
