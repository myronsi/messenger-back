{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerChatCreatedEvent",
  "description": "A chat was created with you.",
  "type": "object",
  "properties": {
    "type": {
      "const": "chat_created"
    },
    "event_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "chat_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "data": {
      "type": "object",
      "properties": {
        "chat": {
          "$ref": "../../openapi.yaml#/components/schemas/Chat"
        }
      },
      "required": [
        "chat"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "event_id",
    "chat_id",
    "data"
  ],
  "additionalProperties": false
}
