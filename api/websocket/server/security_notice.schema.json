{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerSecurityNoticeEvent",
  "type": "object",
  "required": [
    "type",
    "event_id",
    "chat_id",
    "data"
  ],
  "properties": {
    "type": {
      "const": "security_notice"
    },
    "event_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "chat_id": {
      "type": "null"
    },
    "data": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "password_reset",
            "password_changed",
            "recovery_key_changed",
            "2fa_enabled",
            "2fa_disabled",
            "passkey_added",
            "passkey_removed",
            "recovery_email_changed",
            "recovery_email_removed",
            "passkey_counter_warning",
            "login",
            "passkey_login",
            "qr_login_approved"
          ]
        },
        "user_agent": {
          "type": "string",
          "maxLength": 512
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
