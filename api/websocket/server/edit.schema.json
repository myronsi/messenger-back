{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerEditEvent",
  "description": "A message was edited.",
  "type": "object",
  "properties": {
    "type": {
      "const": "edit"
    },
    "event_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "chat_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "data": {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "../../openapi.yaml#/components/schemas/Message"
        }
      },
      "required": [
        "message"
      ]
    }
  },
  "required": [
    "type",
    "event_id",
    "chat_id",
    "data"
  ]
}
