{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerTypingEvent",
  "description": "A user started or stopped typing, recording a voice message, choosing a sticker or sending a photo, video or file. Hide it after about 6 seconds without a repeat: the sender may disconnect before it sends `false`.",
  "type": "object",
  "properties": {
    "type": {
      "const": "typing"
    },
    "event_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "chat_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "data": {
      "type": "object",
      "properties": {
        "user_id": {
          "$ref": "../../openapi.yaml#/components/schemas/Id"
        },
        "is_typing": {
          "type": "boolean"
        },
        "action": {
          "description": "What the user is doing. New values may be added: show an unknown one like `typing`.",
          "type": "string",
          "enum": [
            "typing",
            "recording_voice",
            "choosing_sticker",
            "uploading_photo",
            "uploading_video",
            "uploading_file"
          ]
        }
      },
      "required": [
        "user_id",
        "is_typing",
        "action"
      ]
    }
  },
  "required": [
    "type",
    "event_id",
    "chat_id",
    "data"
  ]
}
