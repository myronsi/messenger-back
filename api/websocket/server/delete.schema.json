{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerDeleteEvent",
  "description": "A message was deleted for everyone (deleting for yourself is only sent to your other devices), or removed by moderation.",
  "type": "object",
  "properties": {
    "type": {
      "const": "delete"
    },
    "event_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "chat_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "data": {
      "type": "object",
      "properties": {
        "message_id": {
          "$ref": "../../openapi.yaml#/components/schemas/Id"
        },
        "scope": {
          "type": "string",
          "enum": [
            "me",
            "everyone"
          ]
        },
        "removed_by_moderation": {
          "type": "boolean",
          "description": "`true` when moderation removed the message (`scope` is then `everyone`). Absent otherwise."
        },
        "moderation_reason": {
          "$ref": "../../openapi.yaml#/components/schemas/ModerationRemovalReason",
          "description": "Why moderation removed the message; only in the sender's copy of the event."
        }
      },
      "required": [
        "message_id",
        "scope"
      ]
    }
  },
  "required": [
    "type",
    "event_id",
    "chat_id",
    "data"
  ]
}
