{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerApprovalRequestCreatedEvent",
  "description": "A new request waits in your inbox.",
  "type": "object",
  "properties": {
    "type": {
      "const": "approval_request_created"
    },
    "event_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "chat_id": {
      "oneOf": [
        {
          "$ref": "../../openapi.yaml#/components/schemas/Id"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "../../openapi.yaml#/components/schemas/ApprovalRequest"
        }
      },
      "required": [
        "request"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "event_id",
    "chat_id",
    "data"
  ],
  "additionalProperties": false
}
