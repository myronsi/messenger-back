{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientEditEvent",
  "description": "Edit your own text message or the caption of your file. An empty content removes a file's caption.",
  "type": "object",
  "properties": {
    "type": {
      "const": "edit"
    },
    "client_temp_id": {
      "$ref": "../../openapi.yaml#/components/schemas/ClientTempId"
    },
    "chat_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "data": {
      "type": "object",
      "properties": {
        "message_id": {
          "$ref": "../../openapi.yaml#/components/schemas/Id"
        },
        "content": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "message_id",
        "content"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "client_temp_id",
    "chat_id",
    "data"
  ],
  "additionalProperties": false
}
