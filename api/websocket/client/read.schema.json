{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientReadEvent",
  "description": "Mark messages as read up to and including `message_id`.",
  "type": "object",
  "properties": {
    "type": {
      "const": "read"
    },
    "client_temp_id": {
      "$ref": "../../openapi.yaml#/components/schemas/ClientTempId"
    },
    "chat_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "data": {
      "type": "object",
      "properties": {
        "message_id": {
          "$ref": "../../openapi.yaml#/components/schemas/Id"
        }
      },
      "required": [
        "message_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "client_temp_id",
    "chat_id",
    "data"
  ],
  "additionalProperties": false
}
