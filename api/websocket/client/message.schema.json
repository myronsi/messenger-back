{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientMessageEvent",
  "description": "Send a message. Idempotent per `client_temp_id`; answered with `ack` or `error`.",
  "type": "object",
  "properties": {
    "type": {
      "const": "message"
    },
    "client_temp_id": {
      "$ref": "../../openapi.yaml#/components/schemas/ClientTempId"
    },
    "chat_id": {
      "$ref": "../../openapi.yaml#/components/schemas/Id"
    },
    "data": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "text",
            "file",
            "voice"
          ]
        },
        "content": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "attachment_id": {
          "oneOf": [
            {
              "$ref": "../../openapi.yaml#/components/schemas/Id"
            },
            {
              "type": "null"
            }
          ],
          "description": "Required for `file` and `voice`; never a URL."
        },
        "reply_to": {
          "oneOf": [
            {
              "$ref": "../../openapi.yaml#/components/schemas/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "client_temp_id",
    "chat_id",
    "data"
  ],
  "additionalProperties": false
}
